# Browser-safe Supabase configuration. These are public identifiers, not secrets.
# Local demo may stay true. Production deployment preflight requires HTTPS APP_URL and demo=false.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Server-only configuration. Never expose these to browser or mobile bundles.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_ACCESS_TOKEN=replace-with-supabase-cli-access-token
DEMO_SEED_PASSWORD=replace-with-local-only-password

# P08 notification worker. Use independent random secrets in deployed environments.
# PUSH_TOKEN_ENCRYPTION_KEY must decode to exactly 32 bytes (64 hex chars or base64).
AUTOMATION_SECRET=replace-with-random-automation-secret
PUSH_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-or-64-char-hex-key

# Mobile public configuration. Keep to public identifiers only.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
EXPO_PUBLIC_OPSDESK_WEB_URL=http://localhost:3000
EXPO_PUBLIC_EAS_PROJECT_ID=replace-with-eas-project-uuid

# Attendance server ingress verification. Leave disabled until deployed behind a trusted adapter.
# Supported values in this phase: none | vercel | cloudflare
ATTENDANCE_TRUSTED_INGRESS=none

# Optional integrations; keep empty until an adapter is configured.
SMTP_API_KEY=
EXPO_ACCESS_TOKEN=

