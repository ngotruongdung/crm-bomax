{
  "name": "opsdesk",
  "private": true,
  "version": "0.1.0",
  "description": "OpsDesk - nền tảng vận hành team thương mại điện tử",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @opsdesk/web dev",
    "dev:mobile": "pnpm --filter @opsdesk/mobile start",
    "build": "pnpm build:web",
    "build:web": "pnpm --filter @opsdesk/web build",
    "build:mobile": "pnpm --filter @opsdesk/mobile run export:all",
    "build:mobile:web": "pnpm --filter @opsdesk/mobile run export:web",
    "lint": "pnpm --filter @opsdesk/web lint && pnpm --filter @opsdesk/mobile lint && pnpm --filter @opsdesk/design-tokens lint && pnpm --filter @opsdesk/contracts lint && pnpm --filter @opsdesk/domain lint && pnpm --filter @opsdesk/api-client lint",
    "typecheck": "pnpm --filter @opsdesk/web typecheck && pnpm --filter @opsdesk/mobile typecheck && pnpm --filter @opsdesk/design-tokens typecheck && pnpm --filter @opsdesk/contracts typecheck && pnpm --filter @opsdesk/domain typecheck && pnpm --filter @opsdesk/api-client typecheck",
    "test": "pnpm --filter @opsdesk/domain test && pnpm --filter @opsdesk/web test",
    "test:e2e": "pnpm --filter @opsdesk/web test:e2e",
    "db:reset": "supabase db reset",
    "test:db": "pnpm db:reset",
    "test:db:static": "node scripts/verify-db-migrations.mjs",
    "test:db:pgtap": "supabase test db",
    "test:db:remote:probe": "node scripts/probe-supabase-runtime.mjs",
    "test:auth:rls:remote": "node scripts/smoke-supabase-auth-rls.mjs",
    "test:runtime:remote": "pnpm test:db:remote:probe && pnpm test:auth:rls:remote",
    "check:demo:hosted": "node scripts/check-hosted-demo-data.mjs",
    "test:web:session:remote": "node scripts/smoke-web-session-ssr.mjs",
    "build:supabase:dashboard-sql": "node scripts/build-supabase-dashboard-sql.mjs",
    "db:types": "node scripts/generate-db-types.mjs",
    "types:db": "pnpm db:types",
    "seed:demo": "pnpm --filter @opsdesk/web exec node scripts/seed-auth-demo.mjs",
    "seed:auth-demo": "pnpm seed:demo",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json,mjs}\" \"packages/**/*.{ts,json,mjs}\" \"scripts/**/*.mjs\" \"*.json\" \"README.md\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json,mjs}\" \"packages/**/*.{ts,json,mjs}\" \"scripts/**/*.mjs\" \"*.json\" \"README.md\"",
    "check:env": "node scripts/validate-env.mjs",
    "verify:env": "node scripts/validate-env.mjs --strict",
    "verify:env:server": "node scripts/validate-env.mjs --strict --require-invitation-service",
    "verify:env:production": "node scripts/validate-env.mjs --strict --production --require-invitation-service",
    "check:mobile": "pnpm --filter @opsdesk/mobile check",
    "secret-scan": "node scripts/secret-scan.mjs",
    "check": "pnpm check:env && pnpm secret-scan && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:deployment": "pnpm verify:env:production && pnpm check && pnpm check:mobile && pnpm build:mobile && pnpm test:db:static && pnpm db:reset && pnpm db:types && pnpm test:db:pgtap && pnpm format:check"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.52.0",
    "@typescript-eslint/parser": "8.71.0",
    "@types/node": "22.15.14",
    "eslint": "9.35.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
